{
  "schema_version": 1,
  "diagram_type": "c4",
  "meta": {
    "title": "Spring PetClinic Microservices",
    "subtitle": "Modelo C4 extraído do código: contexto e contêineres da aplicação de clínica veterinária.",
    "locale": "pt-BR",
    "quality_profile": "showcase",
    "glossary": {
      "API": "Interface de programação de aplicações (Application Programming Interface)",
      "HTTP": "Protocolo de transferência de hipertexto (Hypertext Transfer Protocol)",
      "HTTPS": "HTTP protegido por TLS",
      "JSON": "Formato de troca de dados em texto (JavaScript Object Notation)",
      "JDBC": "API Java de acesso a bancos relacionais (Java Database Connectivity)",
      "JPA": "Padrão Java de mapeamento objeto-relacional (Jakarta Persistence API)",
      "MVC": "Padrão Model-View-Controller, aqui o Spring Web MVC",
      "HSQLDB": "Banco relacional Java executado em memória (HyperSQL Database)",
      "LLM": "Modelo de linguagem de grande porte (Large Language Model)",
      "Spring AI": "Projeto Spring para integrar modelos de IA e chamadas de ferramentas",
      "Eureka": "Registro de serviços do Spring Cloud Netflix",
      "Zipkin": "Servidor de rastreamento distribuído",
      "Resilience4j": "Biblioteca de circuit breaker e retentativas",
      "WebFlux": "Pilha web reativa do Spring",
      "Git": "Sistema de controle de versão"
    }
  },
  "model": {
    "elements": [
      {
        "id": "funcionario",
        "type": "person",
        "name": "Funcionário da Clínica",
        "description": "Cadastra tutores, pets e visitas, consulta veterinários e usa o assistente."
      },
      {
        "id": "operacoes",
        "type": "person",
        "name": "Equipe de Operações",
        "description": "Acompanha saúde, métricas e rastreamentos dos microsserviços."
      },
      {
        "id": "petclinic",
        "type": "softwareSystem",
        "name": "Spring PetClinic",
        "description": "Gerencia tutores, pets, visitas e veterinários de uma clínica, com assistente de IA."
      },
      {
        "id": "frontend",
        "type": "container",
        "parent": "petclinic",
        "name": "Aplicação Web",
        "technology": "Vue.js, Vue Router, Bootstrap",
        "description": "Interface no navegador, servida pelo API Gateway."
      },
      {
        "id": "gateway",
        "type": "container",
        "parent": "petclinic",
        "name": "API Gateway",
        "technology": "Spring Cloud Gateway",
        "description": "Roteia /api/*, agrega tutor e visitas; circuit breaker Resilience4j."
      },
      {
        "id": "customers",
        "type": "container",
        "parent": "petclinic",
        "name": "Customers Service",
        "technology": "Spring Boot, Spring Data JPA",
        "description": "Mantém tutores, pets e tipos de pet."
      },
      {
        "id": "vets",
        "type": "container",
        "parent": "petclinic",
        "name": "Vets Service",
        "technology": "Spring Boot, JPA, Caffeine",
        "description": "Disponibiliza veterinários e especialidades, com cache."
      },
      {
        "id": "visits",
        "type": "container",
        "parent": "petclinic",
        "name": "Visits Service",
        "technology": "Spring Boot, Spring Data JPA",
        "description": "Registra e consulta as visitas dos pets."
      },
      {
        "id": "genai",
        "type": "container",
        "parent": "petclinic",
        "name": "GenAI Service",
        "technology": "Spring Boot, Spring AI",
        "description": "Assistente de chat que responde e age via ferramentas; índice vetorial em memória."
      },
      {
        "id": "db_customers",
        "type": "container",
        "parent": "petclinic",
        "name": "Banco de Clientes",
        "technology": "HSQLDB (padrão) ou MySQL",
        "shape": "database",
        "description": "Guarda tutores, pets e tipos de pet; em memória por padrão."
      },
      {
        "id": "db_vets",
        "type": "container",
        "parent": "petclinic",
        "name": "Banco de Veterinários",
        "technology": "HSQLDB (padrão) ou MySQL",
        "shape": "database",
        "description": "Guarda veterinários e especialidades; em memória por padrão."
      },
      {
        "id": "db_visits",
        "type": "container",
        "parent": "petclinic",
        "name": "Banco de Visitas",
        "technology": "HSQLDB (padrão) ou MySQL",
        "shape": "database",
        "description": "Guarda as visitas dos pets; em memória por padrão."
      },
      {
        "id": "config",
        "type": "container",
        "parent": "petclinic",
        "name": "Config Server",
        "technology": "Spring Cloud Config Server",
        "description": "Centraliza a configuração de todos os serviços."
      },
      {
        "id": "discovery",
        "type": "container",
        "parent": "petclinic",
        "name": "Discovery Server",
        "technology": "Spring Cloud Netflix Eureka",
        "description": "Registro de serviços usado no balanceamento de carga (lb://)."
      },
      {
        "id": "admin",
        "type": "container",
        "parent": "petclinic",
        "name": "Admin Server",
        "technology": "Spring Boot Admin",
        "description": "Painel de saúde e detalhes das instâncias registradas."
      },
      {
        "id": "tracing",
        "type": "container",
        "parent": "petclinic",
        "name": "Tracing Server",
        "technology": "Zipkin",
        "description": "Recebe e exibe os rastreamentos distribuídos das requisições."
      },
      {
        "id": "prometheus",
        "type": "container",
        "parent": "petclinic",
        "name": "Prometheus",
        "technology": "Prometheus",
        "description": "Coleta e armazena métricas dos serviços a cada 15 segundos."
      },
      {
        "id": "grafana",
        "type": "container",
        "parent": "petclinic",
        "name": "Grafana",
        "technology": "Grafana",
        "description": "Exibe o painel Spring Petclinic Metrics a partir do Prometheus."
      },
      {
        "id": "llm",
        "type": "softwareSystem",
        "external": true,
        "name": "Provedor de LLM",
        "description": "OpenAI (padrão, gpt-4o-mini) ou Azure OpenAI; gera as respostas do chat."
      },
      {
        "id": "configrepo",
        "type": "softwareSystem",
        "external": true,
        "name": "Repositório de Configuração",
        "description": "Repositório Git no GitHub com os arquivos de configuração dos serviços."
      }
    ],
