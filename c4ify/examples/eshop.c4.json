{
  "schema_version": 1,
  "diagram_type": "c4",
  "meta": {
    "title": "eShop",
    "subtitle": "C4 model of the .NET eShop reference application, derived from eShop.AppHost and the service projects.",
    "locale": "en",
    "quality_profile": "showcase",
    "glossary": {
      "BFF": "Backend for Frontend, a gateway tailored to one client",
      "YARP": "Yet Another Reverse Proxy, Microsoft's .NET reverse proxy",
      "gRPC": "Google Remote Procedure Call, binary RPC over HTTP/2",
      "AMQP": "Advanced Message Queuing Protocol, spoken by RabbitMQ",
      "OIDC": "OpenID Connect, the sign-in and token protocol",
      "EF Core": "Entity Framework Core, the .NET object-relational mapper",
      "MAUI": ".NET Multi-platform App UI, cross-platform native apps",
      "RESP": "Redis Serialization Protocol",
      "SQL": "Structured Query Language",
      "JSON": "JavaScript Object Notation",
      "HTTP": "Hypertext Transfer Protocol",
      "HTTPS": "HTTP over TLS",
      "API": "Application Programming Interface",
      "ASP.NET": "Microsoft's web framework for .NET"
    }
  },
  "model": {
    "elements": [
      {
        "id": "customer",
        "type": "person",
        "name": "Customer",
        "description": "Browses the catalogue, fills a basket and places and tracks orders."
      },
      {
        "id": "partner",
        "type": "person",
        "name": "Webhook Subscriber",
        "description": "Registers webhooks to be told when orders are paid or shipped."
      },
      {
        "id": "eshop",
        "type": "softwareSystem",
        "name": "eShop",
        "description": "Online store: catalogue, basket, ordering, payment simulation and webhooks."
      },
      {
        "id": "foundry",
        "type": "softwareSystem",
        "external": true,
        "name": "Microsoft Foundry (optional)",
        "description": "Hosts the chat and text-embedding models used when UseFoundry is set."
      },
      {
        "id": "webapp",
        "type": "container",
        "parent": "eshop",
        "name": "Web App",
        "technology": "ASP.NET Core, Blazor Server",
        "description": "Online store UI with AI chat; shows live order status."
      },
      {
        "id": "mobileapp",
        "type": "container",
        "parent": "eshop",
        "name": "Mobile App",
        "technology": ".NET MAUI",
        "description": "Native shopping app for Android, iOS, Windows and macOS."
      },
      {
        "id": "bff",
        "type": "container",
        "parent": "eshop",
        "name": "Mobile BFF",
        "technology": "YARP reverse proxy",
        "description": "Routes mobile catalogue, order and identity calls to the services."
      },
      {
        "id": "identity",
        "type": "container",
        "parent": "eshop",
        "name": "Identity API",
        "technology": "Duende IdentityServer",
        "description": "Signs users in and issues access tokens to the apps and APIs."
      },
      {
        "id": "basket",
        "type": "container",
        "parent": "eshop",
        "name": "Basket API",
        "technology": "ASP.NET Core gRPC service",
        "description": "Keeps each customer's shopping basket."
      },
      {
        "id": "catalog",
        "type": "container",
        "parent": "eshop",
        "name": "Catalog API",
        "technology": "ASP.NET Core Minimal API",
        "description": "Serves products, brands, pictures and semantic search; confirms stock."
      },
      {
        "id": "ordering",
        "type": "container",
        "parent": "eshop",
        "name": "Ordering API",
        "technology": "ASP.NET Core Minimal API",
        "description": "Creates orders and drives their status through validation, payment and shipping."
      },
      {
        "id": "orderproc",
        "type": "container",
        "parent": "eshop",
        "name": "Order Processor",
        "technology": ".NET worker service",
        "description": "Confirms orders whose grace period has expired."
      },
      {
        "id": "payproc",
        "type": "container",
        "parent": "eshop",
        "name": "Payment Processor",
        "technology": ".NET worker service",
        "description": "Simulates payment for orders whose stock is confirmed."
      },
      {
        "id": "webhooks",
        "type": "container",
        "parent": "eshop",
        "name": "Webhooks API",
        "technology": "ASP.NET Core Minimal API",
        "description": "Stores webhook subscriptions and posts order and price events to them."
      },
      {
        "id": "webhookclient",
        "type": "container",
        "parent": "eshop",
        "name": "Webhook Client",
        "technology": "ASP.NET Core, Blazor",
        "description": "Sample client that registers webhooks and shows the ones received."
      },
      {
        "id": "eventbus",
        "type": "container",
        "parent": "eshop",
        "name": "Event Bus",
        "technology": "RabbitMQ",
        "shape": "queue",
        "description": "Carries integration events between the services."
      },
      {
        "id": "redis",
        "type": "container",
        "parent": "eshop",
        "name": "Basket Store",
        "technology": "Redis",
        "shape": "database",
        "description": "Holds baskets keyed by buyer."
      },
      {
        "id": "catalogdb",
        "type": "container",
        "parent": "eshop",
        "name": "Catalog Database",
        "technology": "PostgreSQL + pgvector",
        "shape": "database",
        "description": "Stores products, brands, types and their embeddings."
      },
      {
        "id": "identitydb",
        "type": "container",
        "parent": "eshop",
        "name": "Identity Database",
        "technology": "PostgreSQL",
        "shape": "database",
        "description": "Stores user accounts."
      },
      {
        "id": "orderingdb",
        "type": "container",
        "parent": "eshop",
        "name": "Ordering Database",
        "technology": "PostgreSQL",
        "shape": "database",
        "description": "Stores orders, buyers, payment methods and the outbox of events."
      },
      {
        "id": "webhooksdb",
        "type": "container",
        "parent": "eshop",
        "name": "Webhooks Database",
        "technology": "PostgreSQL",
        "shape": "database",
        "description": "Stores webhook subscriptions."
      },
      {
        "id": "ord_api",
        "type": "component",
        "parent": "ordering",
        "name": "Orders Endpoints",
        "technology": "ASP.NET Core Minimal API",
        "description": "Versioned /api/orders routes: create, draft, cancel, ship and list orders."
      },
      {
        "id": "ord_commands",
        "type": "component",
        "parent": "ordering",
        "name": "Command Handlers",
        "technology": "MediatR, FluentValidation",
        "description": "Validate, log and run create, cancel, ship and status commands in one transaction."
      },
      {
        "id": "ord_queries",
        "type": "component",
        "parent": "ordering",
        "name": "Order Queries",
        "technology": "EF Core",
        "description": "Reads orders, order summaries and card types for display."
      },
      {
        "id": "ord_domain",
        "type": "component",
        "parent": "ordering",
        "name": "Order and Buyer Aggregates",
        "technology": "Ordering.Domain",
        "description": "Enforces order and buyer rules and raises domain events."
      },
      {
        "id": "ord_repos",
        "type": "component",
        "parent": "ordering",
        "name": "Repositories and OrderingContext",
        "technology": "EF Core, Npgsql",
        "description": "Persists aggregates and dispatches their domain events on save."
      },
      {
        "id": "ord_domainhandlers",
        "type": "component",
        "parent": "ordering",
        "name": "Domain Event Handlers",
        "technology": "MediatR notifications",
        "description": "Update buyers and turn status changes into integration events."
      },
      {
        "id": "ord_outbox",
        "type": "component",
        "parent": "ordering",
        "name": "Integration Event Service",
        "technology": "EF Core outbox",
        "description": "Saves integration events with the transaction, then publishes them."
      },
      {
        "id": "ord_inthandlers",
        "type": "component",
        "parent": "ordering",
        "name": "Integration Event Handlers",
        "technology": "EventBusRabbitMQ",
        "description": "React to grace-period, stock and payment events by sending commands."
      }
    ],
