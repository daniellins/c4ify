{
  "name": "c4ify",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "C4 model diagrams (system landscape, context, container, component) from one JSON model with many views, rendered as explorable standalone HTML; forked from bizify, a fork of Archify 2.17.0-dev.1.",
  "license": "MIT",
  "bin": {
    "c4ify": "./bin/c4ify.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "generate:validators": "node scripts/generate-validators.mjs",
    "check:validators": "node scripts/generate-validators.mjs --check",
    "generate:palette": "node scripts/generate-kind-palette.mjs",
    "check:palette": "node scripts/generate-kind-palette.mjs --check",
    "generate:brand-marks": "node scripts/generate-brand-marks.mjs",
    "check:brand-marks": "node scripts/generate-brand-marks.mjs --check",
    "test": "npm run check:validators && npm run check:palette && node scripts/run-tests.mjs",
    "render:examples": "node scripts/render-examples.mjs"
  },
  "devDependencies": {
    "ajv": "^8.17.1",
    "simple-icons": "16.34.0"
  },
  "overrides": {
    "fast-uri": "^3.1.7"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/daniellins/c4ify.git"
  },
  "homepage": "https://github.com/daniellins/c4ify",
  "author": "Daniel Lins"
}
