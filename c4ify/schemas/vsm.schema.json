{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/bizify/bizify/schemas/vsm.schema.json",
  "title": "Bizify Value Stream Map / Mapa do Fluxo de Valor",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagram_type", "meta", "nodes", "flows"],
  "$defs": {
    "timeUnit": { "enum": ["min", "h", "d"] },
    "positive": { "type": "number", "exclusiveMinimum": 0 },
    "text": { "type": "string", "minLength": 1, "maxLength": 60 }
  },
  "properties": {
    "schema_version": { "const": 1 },
    "diagram_type": { "const": "vsm" },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "variant", "state"],
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "output": { "type": "string" },
        "locale": { "$ref": "common.schema.json#/$defs/locale" },
        "animation": { "$ref": "common.schema.json#/$defs/animation" },
        "visual_preset": { "$ref": "common.schema.json#/$defs/visualPreset" },
        "quality_profile": { "$ref": "common.schema.json#/$defs/qualityProfile" },
        "views": { "$ref": "common.schema.json#/$defs/guidedViews" },
        "waivers": { "$ref": "common.schema.json#/$defs/waivers" },
        "viewBox": { "$ref": "common.schema.json#/$defs/viewBox" },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": { "$ref": "common.schema.json#/$defs/legendMode" },
            "entries": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "vsm-supplier": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-customer": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-control": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-process": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-inventory": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-queue": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-supermarket": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-fifo": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "vsm-kaizen": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "push-flow": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "pull-flow": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "fifo-flow": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "shipment-flow": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "manual-info": { "$ref": "common.schema.json#/$defs/legendEntry" },
                "electronic-info": { "$ref": "common.schema.json#/$defs/legendEntry" }
              }
            }
          }
        },
        "variant": { "enum": ["office", "manufacturing"] },
        "state": { "enum": ["current", "future"] },
        "value_stream": { "type": "string", "minLength": 1, "maxLength": 80 },
        "champion": { "type": "string", "minLength": 1, "maxLength": 60 },
        "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
        "demand": {
          "type": "object",
          "additionalProperties": false,
          "required": ["qty", "period"],
          "properties": {
            "qty": { "$ref": "#/$defs/positive" },
            "period": { "enum": ["day", "week", "month", "year"] },
            "working_days": { "$ref": "#/$defs/positive" },
            "unit": { "type": "string", "minLength": 1, "maxLength": 20 }
          }
        },
        "work_hours_per_day": { "type": "number", "exclusiveMinimum": 0, "maximum": 24 },
        "available_time_s": { "type": "number", "exclusiveMinimum": 0, "maximum": 86400 },
        "units": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pt": { "$ref": "#/$defs/timeUnit" },
            "lt": { "$ref": "#/$defs/timeUnit" }
          }
        },
        "totals": {
          "type": "object",
          "additionalProperties": false,
          "minProperties": 1,
          "properties": {
            "lead_time": { "type": "number", "minimum": 0 },
            "process_time": { "type": "number", "minimum": 0 },
            "activity_ratio_pct": { "type": "number", "minimum": 0, "maximum": 100 },
            "rolled_pct_ca": { "type": "number", "minimum": 0, "maximum": 100 },
            "takt_s": { "type": "number", "minimum": 0 },
            "inventory_days": { "type": "number", "minimum": 0 }
          }
        },
        "node_width": { "type": "number", "minimum": 130, "maximum": 220 },
        "summary": { "type": "boolean" }
      }
    },
    "nodes": {
      "type": "array",
      "minItems": 2,
      "maxItems": 40,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "kind", "label"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "kind": { "enum": ["supplier", "customer", "control", "process", "inventory", "queue", "supermarket", "fifo", "kaizen"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 48 },
          "description": { "type": "string", "minLength": 1, "maxLength": 240 },
          "role": { "$ref": "#/$defs/text" },
          "delivery": { "$ref": "#/$defs/text" },
          "staff": { "type": "integer", "minimum": 1, "maximum": 999 },
          "pacemaker": { "type": "boolean" },
          "pt": { "type": "number" },
          "lt": { "type": "number" },
          "pct_ca": { "type": "number" },
          "ct_s": { "type": "number" },
          "co_min": { "type": "number", "minimum": 0 },
          "uptime_pct": { "type": "number", "exclusiveMinimum": 0, "maximum": 100 },
          "operators": { "type": "integer", "minimum": 0, "maximum": 999 },
          "shifts": { "type": "integer", "minimum": 1, "maximum": 4 },
          "epe": { "type": "string", "minLength": 1, "maxLength": 16 },
          "scrap_pct": { "type": "number", "minimum": 0, "maximum": 100 },
          "before": { "$ref": "common.schema.json#/$defs/id" },
          "after": { "$ref": "common.schema.json#/$defs/id" },
          "qty": { "type": "number", "minimum": 0 },
          "qty_unit": { "type": "string", "minLength": 1, "maxLength": 12 },
          "daily_demand": { "$ref": "#/$defs/positive" },
          "wait": { "type": "number", "minimum": 0 },
          "wait_unit": { "$ref": "#/$defs/timeUnit" },
          "max_qty": { "$ref": "#/$defs/positive" },
          "owner": { "$ref": "common.schema.json#/$defs/id" },
          "target": { "$ref": "common.schema.json#/$defs/id" },
          "waste": {
            "type": "array",
            "maxItems": 4,
            "items": { "enum": ["transport", "inventory", "motion", "waiting", "overproduction", "overprocessing", "defects", "skills", "partially-done-work", "task-switching", "handoffs", "extra-features", "relearning"] }
          }
        }
      }
    },
    "flows": {
      "type": "array",
      "maxItems": 60,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["from", "to", "channel", "kind"],
        "properties": {
          "id": { "$ref": "common.schema.json#/$defs/id" },
          "from": { "$ref": "common.schema.json#/$defs/id" },
          "to": { "$ref": "common.schema.json#/$defs/id" },
          "channel": { "enum": ["material", "info"] },
          "kind": { "enum": ["push", "pull", "fifo", "withdrawal", "shipment", "manual", "electronic"] },
          "label": { "type": "string", "minLength": 1, "maxLength": 32 }
        }
      }
    },
    "cards": { "$ref": "common.schema.json#/$defs/cards" }
  }
}
