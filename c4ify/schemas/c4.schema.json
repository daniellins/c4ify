{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/daniellins/c4ify/schemas/c4.schema.json",
  "title": "c4ify C4 model (one model, many views)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "diagram_type",
    "meta",
    "model",
    "views"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "diagram_type": {
      "const": "c4"
    },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "subtitle": {
          "type": "string",
          "maxLength": 240
        },
        "output": {
          "type": "string"
        },
        "locale": {
          "$ref": "common.schema.json#/$defs/locale"
        },
        "animation": {
          "$ref": "common.schema.json#/$defs/animation"
        },
        "visual_preset": {
          "$ref": "common.schema.json#/$defs/visualPreset"
        },
        "quality_profile": {
          "$ref": "common.schema.json#/$defs/qualityProfile"
        },
        "waivers": {
          "$ref": "common.schema.json#/$defs/waivers"
        },
        "glossary": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {
            "pattern": "^[A-Za-z0-9][A-Za-z0-9&/.+ -]{0,15}$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 2,
            "maxLength": 120
          }
        },
        "legend": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "mode": {
              "$ref": "common.schema.json#/$defs/legendMode"
            },
            "entries": {
              "type": "object",
              "propertyNames": {
                "enum": [
                  "person",
                  "software-system",
                  "container",
                  "component",
                  "external-person",
                  "external-system",
                  "external-container",
                  "external-component"
                ]
              },
              "additionalProperties": {
                "$ref": "common.schema.json#/$defs/legendEntry"
              }
            }
          }
        }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "elements",
        "relationships"
      ],
      "properties": {
        "enterprise": {
          "$ref": "common.schema.json#/$defs/shortText"
        },
        "elements": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "items": {
            "$ref": "#/$defs/element"
          }
        },
        "relationships": {
          "type": "array",
          "maxItems": 400,
          "items": {
            "$ref": "#/$defs/relationship"
          }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "maxItems": 24,
      "items": {
        "$ref": "#/$defs/view"
      }
    },
    "cards": {
      "$ref": "common.schema.json#/$defs/cards"
    }
  },
  "$defs": {
    "element": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "name"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "type": {
          "enum": [
            "person",
            "softwareSystem",
            "container",
            "component"
          ]
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 60
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "technology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 48
        },
        "parent": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "external": {
          "type": "boolean"
        },
        "shape": {
          "enum": [
            "box",
            "database",
            "queue"
          ]
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        },
        "brand": {
          "$ref": "common.schema.json#/$defs/brandMark"
        }
      }
    },
    "relationship": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "id": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "from": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "description": {
          "type": "string",
          "maxLength": 80
        },
        "technology": {
          "type": "string",
          "minLength": 1,
          "maxLength": 40
        },
        "async": {
          "type": "boolean"
        },
        "tags": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 32
          }
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from",
        "to"
      ],
      "properties": {
        "from": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "to": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "fromSide": {
          "$ref": "common.schema.json#/$defs/side"
        },
        "toSide": {
          "$ref": "common.schema.json#/$defs/side"
        },
        "route": {
          "enum": [
            "auto",
            "straight",
            "orthogonal-h",
            "orthogonal-v"
          ]
        },
        "via": {
          "type": "array",
          "maxItems": 8,
          "items": {
            "$ref": "common.schema.json#/$defs/point"
          }
        },
        "labelAt": {
          "$ref": "common.schema.json#/$defs/point"
        },
        "labelDx": {
          "type": "number"
        },
        "labelDy": {
          "type": "number"
        },
        "labelSegment": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "cell": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "row",
        "col"
      ],
      "properties": {
        "row": {
          "type": "integer",
          "minimum": 0,
          "maximum": 20
        },
        "col": {
          "type": "number",
          "minimum": 0,
          "maximum": 20,
          "multipleOf": 0.5
        }
      }
    },
    "view": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "key",
        "type"
      ],
      "properties": {
        "key": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "type": {
          "enum": [
            "systemLandscape",
            "systemContext",
            "container",
            "component"
          ]
        },
        "scope": {
          "$ref": "common.schema.json#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120
        },
        "description": {
          "type": "string",
          "maxLength": 240
        },
        "include": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "exclude": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "$ref": "common.schema.json#/$defs/id"
          }
        },
        "layout": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "max_per_row": {
              "type": "integer",
              "minimum": 2,
              "maximum": 8
            },
            "element_width": {
              "type": "number",
              "minimum": 160,
              "maximum": 300
            },
            "gap_x": {
              "type": "number",
              "minimum": 60,
              "maximum": 240
            },
            "gap_y": {
              "type": "number",
              "minimum": 90,
              "maximum": 260
            },
            "direction": {
              "enum": [
                "TB",
                "LR"
              ]
            },
            "fit": {
              "enum": [
                "screen",
                "scroll"
              ]
            }
          }
        },
        "placement": {
          "type": "object",
          "maxProperties": 40,
          "propertyNames": {
            "pattern": "^[a-zA-Z][a-zA-Z0-9_-]*$"
          },
          "additionalProperties": {
            "$ref": "#/$defs/cell"
          }
        },
        "routes": {
          "type": "array",
          "maxItems": 60,
          "items": {
            "$ref": "#/$defs/route"
          }
        },
        "chapters": {
          "$ref": "common.schema.json#/$defs/guidedViews"
        },
        "viewBox": {
          "$ref": "common.schema.json#/$defs/viewBox"
        },
        "exclude_relationships": {
          "type": "array",
          "maxItems": 40,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "from",
              "to"
            ],
            "properties": {
              "from": {
                "type": "string",
                "pattern": "^(\\*|[a-zA-Z][a-zA-Z0-9_-]*)$"
              },
              "to": {
                "type": "string",
                "pattern": "^(\\*|[a-zA-Z][a-zA-Z0-9_-]*)$"
              }
            }
          }
        },
        "label": {
          "type": "string",
          "minLength": 1,
          "maxLength": 32
        }
      }
    }
  }
}
